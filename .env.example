# Token que vos elegís para verificar el webhook con Meta (cualquier string)
WHATSAPP_VERIFY_TOKEN=elegi_un_token_secreto

# Token de acceso de la app de WhatsApp Business (Meta for Developers)
WHATSAPP_TOKEN=

# ID del número de teléfono de WhatsApp Business (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=

# Claves para notificaciones push al celular. Se generan una sola vez con:
#   npx web-push generate-vapid-keys
# y se pegan acá (la publica también va hardcodeada en ningún lado más,
# el servidor se la pasa sola al navegador).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@airesdecuyo.com

PORT=3000
